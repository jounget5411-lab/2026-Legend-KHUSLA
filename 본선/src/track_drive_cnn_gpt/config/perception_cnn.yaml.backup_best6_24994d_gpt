yolo_bev_node:
  ros__parameters:
    image_topic: "/image_raw"                 # 카메라 원본 입력
    bev_topic: "/perception/bev"              # 차선 BEV 출력
    signal_topic: "/perception/signals"       # 신호등/LEFT 검출 출력
    yolo_state_topic: "/debug/yolo_state"     # START_R 좌표 등 viewer 진단
    # 배포 시 실제 install 경로로 바꾼다. OpenVINO 검증 후에는 *_openvino_model 폴더.
    model_path: "/home/xytron/xycar_ws/models/best_6_24994d_gpt_openvino_model" # YOLO/OpenVINO 모델
    expected_model_sha256: "24994d33b1a64e0cf8dec12c4da1e400bb75f6f7cc3f4465e5e38743ac915e40" # 원본 PT 무결성값
    camera_yaml: "/home/xytron/xycar_ws/install/track_drive_cnn_gpt/share/track_drive_cnn_gpt/config/camera.yaml" # BEV 카메라 보정
    # 1920x1080의 기존 PyTorch imgsz=640 auto-letterbox 실제 텐서와 동일.
    # OpenVINO export manifest도 반드시 static [384,640]이어야 한다.
    imgsz: [384, 640]                          # YOLO 실제 추론 텐서 H,W
    conf: 0.25                                 # 전체 검출 최소 confidence
    signal_conf: 0.25                          # 신호등 클래스 최소 confidence
    # =====================================================================
    # [현장 수정 A] START_R -> CONE 진입 시점
    # 판단 좌표는 박스 중심이 아니라 박스의 맨 아래 y2이다(화면 위=0, 아래=1).
    # y2 >= cone_enter_bottom_y_min 상태가 confirm_frames회 연속이면 켜진다.
    # 값을 높일수록 더 가까이/늦게, 낮출수록 더 멀리/일찍 켜진다.
    # 현재 0.80은 1080p 원본 기준 y2 >= 864px이다.
    # =====================================================================
    cone_mode_topic: "/perception/cone_trigger" # raw CONE trigger 출력
    start_r_detected_topic: "/perception/start_r_detected" # y2 무관 START_R 보임
    cone_approach_topic: "/perception/cone_approach" # GENERAL 선감속 출력
    cone_trigger_class_name: "START_R"          # CONE 입구 YOLO 클래스명
    cone_trigger_conf: 0.25          # START_R 최소 YOLO confidence
    # y2>=0.70 한 번이면 GENERAL CNN/조향은 유지하고 속도만 8로 낮춘다.
    # 잠깐 미검출돼도 1초 유지되어 감속 명령이 튀지 않는다.
    cone_approach_bottom_y_min: 0.70 # 선감속 시작: 1080p 기준 y2>=756px
    cone_approach_confirm_frames: 1  # 고속 접근이므로 한 프레임에서 바로 감속
    cone_approach_exit_hold_sec: 1.0 # START_R 순간 미검출 시 감속 유지시간
    cone_enter_bottom_y_min: 0.80    # 핵심 현장값: 높일수록 늦게 진입
    cone_enter_confirm_frames: 2     # 연속 확인 횟수
    cone_exit_hold_sec: 1.0          # raw trigger 유지시간; CONE 주행시간 아님
    iou: 0.70                                  # YOLO NMS IoU 기준
    device: "cpu"                             # OpenVINO/CPU 실행 장치
    cv_threads: 4                              # OpenCV CPU 스레드 수
    supersample: 3                             # BEV 마스크 변환 정밀도 배수
    publish_debug: true                        # viewer용 YOLO 진단 발행

cnn_path_node:
  ros__parameters:
    bev_topic: "/perception/bev"              # YOLO 차선 BEV 입력
    scan_topic: "/scan"                       # LiDAR 입력
    signal_topic: "/perception/signals"       # 신호/LEFT 입력
    main_path_topic: "/cnn/path_main"         # viewer용 일반계열 경로
    shortcut_path_topic: "/cnn/path_shortcut" # viewer용 지름길 경로
    # cnn_path가 직접 선택해 motion 입력으로 보낸다. main/shortcut 토픽은
    # viewer와 기록용으로만 유지하며 /center_path publisher는 하나뿐이다.
    center_path_topic: "/center_path"         # motion으로 가는 최종 선택 경로
    # viewer가 실제 active CNN에 들어간 3채널 입력을 그대로 구독한다.
    cnn_input_bev_topic: "/debug/cnn_input_bev" # 실제 CNN 3채널 입력 진단
    route_intent_topic: "/route_intent"         # MAIN/SHORTCUT 상태 출력
    route_reset_topic: "/route_intent_reset"    # 지름길 강제 초기화 입력
    traffic_stop_topic: "/traffic_stop"         # 신호등 STOP 출력
    traffic_stop_reset_topic: "/traffic_stop_reset" # STOP 강제 해제 입력
    cone_trigger_topic: "/perception/cone_trigger"  # START_R raw trigger 입력
    start_r_detected_topic: "/perception/start_r_detected" # OVERTAKE 선차단 입력
    cnn_mode_topic: "/cnn_mode"                 # 현재 4-CNN 모드 출력
    cone_mode_topic: "/cone_mode"               # CONE 여부 출력
    enable_center_path: true                      # 최종 경로 발행 허용
    # =====================================================================
    # [현장 수정 B] 모드 진입 확인 및 유지시간
    # 같은 trigger가 반복돼도 이미 시작된 타이머는 연장되지 않는다.
    # =====================================================================
    left_confirm_frames: 2           # LEFT 및 정지선 신호 연속 확인 횟수
    left_confidence: 0.25            # LEFT 최소 confidence
    shortcut_hold_sec: 10.0          # SHORTCUT 유지시간
    overtake_hold_sec: 7.0           # OVERTAKE 유지시간
    cone_hold_sec: 14.0              # CONE 유지시간(위 exit_hold와 다름)
    left_confirm_window_sec: 1.5     # 이 시간 안에 LEFT 2회 필요
    left_rearm_absent_frames: 3      # LEFT 재무장에 필요한 미검출 프레임

    # =====================================================================
    # [현장 수정 C] GREEN/LEFT/RED/YELLOW 정지선 판단
    # 모든 신호는 박스 중심 y <= center_y_max 이고
    # 폭 >= min_width일 때만 정지/지름길 선택을 확정한다.
    # 너무 일찍 정지: center_y_max↓ 또는 min_width↑
    # 너무 늦게 정지: center_y_max↑ 또는 min_width↓
    # =====================================================================
    signal_decision_center_y_max: 0.22 # 신호 박스 중심 y 최대값(작을수록 위쪽)
    signal_decision_min_width: 0.08    # 신호 박스 최소 화면 폭 비율
    # 네 모델을 시작 시 한 번 올리고 active mode 한 개만 추론한다.
    general_model_path: "/home/xytron/xycar_ws/models/general_single_best_gpt.pt" # 일반 CNN
    general_expected_sha256: "e90b0de551fdcdde5a5de96d754365380f49db412242535313c396a77201c1b1" # 일반 CNN 무결성
    shortcut_model_path: "/home/xytron/xycar_ws/models/left_shortcut_single_best_gpt.pt" # 지름길 CNN
    shortcut_expected_sha256: "88dc9a1da262c2622e2b618f1fb6789aa5027f3fc3f9bc03c04dcdbef648ae1a" # 지름길 CNN 무결성
    overtake_model_path: "/home/xytron/xycar_ws/models/obstacle_single_best_gpt.pt" # 추월 CNN
    overtake_expected_sha256: "23ff59b918a5af0dbbd31dfb8dcd41713b5c8554f5e38cdf8f07ed1bb37fb463" # 추월 CNN 무결성
    cone_model_path: "/home/xytron/xycar_ws/models/cone_single_all967_final_gpt.pt" # 라바콘 CNN
    cone_expected_sha256: "4844b66bb4440580b2cf39cc6ac7e5e8cc9538d3c1a13579f5267094abb18d13" # 라바콘 CNN 무결성
    device: "cpu"                             # CNN 실행 장치
    torch_threads: 2                           # CNN CPU 스레드 수
    allow_unverified_legacy: false             # 검증 안 된 구형 모델 차단
    lidar_range_scale: 1.1476                  # LiDAR 거리 실측 보정 배율
    lidar_min_range: 0.05                      # 사용할 최소 거리(m)
    lidar_max_range: 8.0                       # 사용할 최대 거리(m)
    # 학습 ego footprint 0.50x0.30m의 반폭/반길이. 목요일 실차에서 LiDAR
    # origin 기준 실제 footprint와 self-return 위치를 반드시 다시 측정한다.
    lidar_self_x_abs: 0.25                     # 자차 제거영역 앞뒤 반길이(m)
    lidar_self_y_abs: 0.15                     # 자차 제거영역 좌우 반폭(m)
    lidar_radius_cells: 1                      # LiDAR 점 BEV 팽창 반경(cell)
    # 학습 데이터와 같은 흰선 바깥 제거 결과를 CNN 3번째 채널로 넣는다.
    min_camera_cells: 1                        # 도로 경계 판단 최소 카메라 cell
    model_lidar_safety_margin_m: 0.025         # CNN용 도로 안쪽 안전 여백(m)
    model_white_guard_m: 0.025                 # 흰선 주변 LiDAR 제거 여백(m)
    # =====================================================================
    # [현장 수정 D] 도로 안 장애물 -> OVERTAKE trigger
    # 우선 조정값: min_raw_points, min_inside_ratio, confirm_frames.
    # 못 잡으면 앞의 두 값을 낮추고, 잡음에도 켜지면 높인다.
    # inward_margin=0.10m와 x_max=1.20m는 승인된 고정 계약이다.
    # =====================================================================
    overtake_inward_margin_m: 0.10              # 흰선에서 도로 안쪽 여백(m), 고정
    overtake_white_guard_m: 0.05                # 흰선 반사점 제외 여백(m)
    overtake_x_min_m: 0.0                       # 장애물 검사 시작 전방거리(m)
    overtake_x_max_m: 1.20                      # 장애물 검사 끝 전방거리(m), 고정
    overtake_min_raw_points: 3                  # trigger 최소 cluster 점 개수
    overtake_min_inside_ratio: 0.50             # cluster 중 도로 안 점 최소 비율
    overtake_min_road_width_m: 0.35             # 유효 도로 최소 폭(m)
    overtake_max_road_width_m: 1.50             # 유효 도로 최대 폭(m)
    overtake_cluster_gap_base_m: 0.15           # 같은 cluster 기본 점 간격(m)
    overtake_cluster_gap_per_m: 0.03            # 거리에 따른 cluster 간격 증가량
    overtake_max_cluster_extent_m: 0.90          # 인정할 cluster 최대 크기(m)
    overtake_confirm_frames: 2                  # 연속 trigger 확인 횟수
    overtake_rearm_clear_frames: 5              # 재무장에 필요한 미검출 프레임
    # BEV header는 카메라 callback 도착시각이다. 실차 flash 측정 전에는 0으로 둔다.
    camera_to_scan_offset_sec: 0.0              # 카메라-LiDAR 시간 오프셋(s)
    sync_slop_sec: 0.18                         # 동기화 허용 시간차(s)
    scan_history_sec: 1.0                       # 보관할 LiDAR 이력(s)
    require_fresh_scan: true                    # 최신 LiDAR 없으면 경로 생성 차단
    # 카메라 수신 시각 기준. 이보다 오래된 BEV는 추론하지 않고 fail-closed 한다.
    max_bev_age_sec: 0.35                       # 허용할 BEV 최대 지연(s)
    valid_threshold: 0.50                       # 단일출력 경로 유효 확률 기준
    shortcut_threshold: 0.50                    # 구형 dual 모델 지름길 선택 기준
    min_valid_points: 6                         # 경로 최소 유효 점 수
    min_valid_span_m: 0.50                      # 경로 최소 전방 길이(m)
    # GT 범위/p99: |y|<=1.5, shortcut slope=3.078, curvature=11.187.
    max_abs_y_m: 1.500001                       # 경로 최대 좌우 범위(m)
    max_abs_slope: 3.1                          # 비정상 경로 최대 기울기
    max_abs_curvature: 12.0                     # 비정상 경로 최대 곡률

cnn_drive_gate_node:
  ros__parameters:
    center_path_topic: "/center_path"          # 최종 CNN 경로 입력
    drive_cmd_topic: "/drive_cmd"              # motion 허용/속도상한 출력
    manual_go_topic: "/manual_go"              # 수동 주행허용 입력
    emergency_stop_topic: "/emergency_stop"    # 비상정지 입력
    traffic_stop_topic: "/traffic_stop"        # 신호등 정지 입력
    control_hz: 20.0                             # gate 출력 주기
    path_stale_sec: 1.0                          # 진단/새 경로 검사값; 경로 유실 STOP에는 사용 안 함
    path_future_tolerance_sec: 0.05              # 진단용 미래 timestamp 허용값(s)
    path_frame_id: "lidar_frame"                # 허용 경로 좌표계
    # 경로 선택/중계는 하지 않는다. false이면 20Hz STOP만 발행한다.
    enable_drive: false                          # launch에서 실제 주행 시 override
    # 실제 주행 launch에서는 false 유지. 모터 토픽이 완전히 remap된
    # live_pipeline_dry_run.launch.py만 true로 override한다.
    initial_manual_go: false                     # 시작 직후 자동 GO 여부
    speed_cap: 6.0                               # 모든 모드 공통 속도 상한

live_pipeline_viewer_node:
  ros__parameters:
    image_topic: "/image_raw"                   # 원본 카메라 표시
    bev_topic: "/perception/bev"                # 차선 BEV 표시
    cnn_input_bev_topic: "/debug/cnn_input_bev" # 실제 CNN LiDAR 포함 입력 표시
    signal_topic: "/perception/signals"         # 신호 검출 표시
    # YOLO가 viewer 구독자가 있을 때만 만드는 per-frame START_R 좌표.
    yolo_state_topic: "/debug/yolo_state"       # START_R 좌표 표시
    cone_trigger_topic: "/perception/cone_trigger" # raw trigger 표시
    cone_mode_topic: "/cone_mode"               # CONE 활성 표시
    cnn_mode_topic: "/cnn_mode"                 # 현재 MODE 표시
    traffic_stop_topic: "/traffic_stop"         # STOP/GO 표시
    # 위 실제 판단값과 동일하게 유지하는 viewer 표시용 fallback 값.
    signal_decision_center_y_max: 0.22            # 표시용 신호 중심 y 기준
    signal_decision_min_width: 0.08               # 표시용 신호 폭 기준
    signal_display_floor: 0.25                    # 미검출 신호는 <0.25로 표시
    cone_enter_bottom_y_min: 0.80                 # 표시용 START_R y2 기준
    cone_approach_bottom_y_min: 0.70              # 표시용 선감속 y2 기준
    overtake_min_raw_points: 3                    # 표시용 장애물 최소 점 수
    motion_topic: "/debug/xycar_motor_dryrun"    # 조향/속도 화살표 입력
    compressed_topic: "/debug/pipeline_view/compressed" # 원격 JPEG 출력
    render_hz: 8.0                                # viewer 갱신 주기
    show_window: true                             # 차량 로컬 창 표시
    # 차량 로컬 창에는 JPEG 재압축이 필요 없다. 노트북 원격 구독 때만
    # launch 인자로 true를 명시한다.
    publish_compressed: false                     # 원격 전송 때만 true
    jpeg_quality: 75                              # 원격 JPEG 품질
    camera_panel_width: 960                       # 카메라 영역 폭(px)
    canvas_height: 720                            # 전체 viewer 높이(px)
    bev_scale: 4                                  # BEV 화면 확대 배율
    speed_visual_max: 10.0                        # 현장 viewer 표시 기준
    window_name: "Xycar CNN live dry-run"         # viewer 창 제목
    screenshot_dir: "/home/xytron/pipeline_view_shots_gpt" # 캡처 저장 폴더
    # Viewer는 /scan을 다시 계산하지 않는다. /debug/cnn_input_bev의
    # 세 번째 채널, 즉 active CNN이 실제 본 LiDAR만 붉은 점으로 표시한다.
